# Copy this file to .env.local and fill in the values.
# Every NEXT_PUBLIC_* value is built into the browser bundle, so anyone using the app can read it.
# Restart `npm run dev` after changing any of them.

# Admin backend: login, refresh, registrations, pharmacy delete
NEXT_PUBLIC_ADMIN_API=http://localhost:8081/api/v1

# Pharma inventory backend: data migration (org directory, CSV template, bulk upload)
NEXT_PUBLIC_PHARMA_BACKEND_API=http://localhost:8080/api/v1

# Value for the X-Upload-Passcode header the pharma backend requires on
# /admin/organizations and /product/bulk-upload (see OperatorPasscode.java in pharma-backend)
NEXT_PUBLIC_UPLOAD_PASSCODE=your-upload-passcode

# Marketplace seller backend
NEXT_PUBLIC_MARKETPLACE_SELLER_API=https://api-test-aggreator.tiameds.ai/api/v1
# Sent as X-API-Key on seller requests
NEXT_PUBLIC_API_KEY=your-seller-api-key

# Not used yet (their clients are commented out in app/lib/axios.ts)
# NEXT_PUBLIC_LAB_BACKEND_API=https://api-test-aggreator.tiameds.ai/api/v1
# NEXT_PUBLIC_MARKETPLACE_BUYER_API=https://api-test-aggreator.tiameds.ai/api/v1
